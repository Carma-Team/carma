ENV=development
HOST=0.0.0.0
PORT=3000

# Logging — JSON when ENV=production, human-readable otherwise. SQL_ECHO=true logs SQL queries.
LOG_LEVEL=INFO
SQL_ECHO=false

DATABASE_URL=postgresql+asyncpg://carma:carma_dev@localhost:5432/carma

JWT_SECRET=change_me_to_a_long_random_string_min_16_chars
JWT_EXPIRES_MINUTES=10080

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
# Codes one phone may trigger per hour, login and registration together.
# Every code is a billed SMS, so this is the cost ceiling per number.
OTP_MAX_PER_HOUR=5

# console = print to log (dev). twilio = real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Azure Application Insights (leave blank to disable)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Comma-separated origins, or * for any.
# While this is *, credentialed cross-origin requests are refused — the CORS
# spec forbids pairing a wildcard with credentials. Name the origins in
# production. The mobile app is unaffected either way; CORS is a browser rule.
CORS_ORIGINS=*

# HMAC key for the trip telemetry digest — the signature gate in docs/fraud-detection.md.
# Leave blank in dev: signature verification becomes a no-op and trips are accepted
# unsigned. ENV=production refuses to start without it, min 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TRIP_SIGNING_SECRET=
