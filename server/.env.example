ENV=development
HOST=0.0.0.0
PORT=3000

# Logging — JSON when ENV=production, human-readable otherwise. SQL_ECHO=true logs SQL queries.
LOG_LEVEL=INFO
SQL_ECHO=false

DATABASE_URL=postgresql+asyncpg://carma:carma_dev@localhost:5432/carma

JWT_SECRET=change_me_to_a_long_random_string_min_16_chars
JWT_EXPIRES_MINUTES=10080

# The web app's access token (minted by POST /api/auth/refresh), kept short
# because it lives in browser memory only. Mobile is unaffected — it still
# gets JWT_EXPIRES_MINUTES from /api/auth/login.
WEB_ACCESS_TOKEN_EXPIRES_MINUTES=15
# How long the web app's httpOnly refresh cookie survives with no activity.
# Each successful refresh rotates it and resets the clock, so this only ever
# signs out a session nobody is using.
REFRESH_TOKEN_EXPIRES_DAYS=30
# lax is correct as long as the web app and the API share a registrable
# domain (true in dev and in every environment this runs in so far). Set to
# none only for a cross-site deployment — that also forces the cookie's
# Secure flag on, so it needs HTTPS.
REFRESH_COOKIE_SAMESITE=lax

OTP_LENGTH=6
OTP_TTL_SECONDS=300
# Failures before the account closes to everyone. The backstop against a guesser
# spread across many addresses — NIST SP 800-63B caps it at 100. The control that
# does the real work is the per-address backoff below.
ACCOUNT_LOCKOUT_AFTER=100
OTP_LOCKOUT_SECONDS=900
# Failures from one address against one account before that address waits, and
# how long the wait grows to (1s, 2s, 4s … up to the cap).
LOGIN_BACKOFF_AFTER=5
LOGIN_BACKOFF_MAX_SECONDS=900
LOGIN_FAILURE_WINDOW_SECONDS=3600
# Codes one phone may trigger per hour, login and registration together.
# Every code is a billed SMS, so this is the cost ceiling per number.
OTP_MAX_PER_HOUR=5

# console = print to log (dev). twilio = real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Azure Application Insights (leave blank to disable)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Comma-separated origins, or * for any.
# While this is *, credentialed cross-origin requests are refused — the CORS
# spec forbids pairing a wildcard with credentials. The business web app
# (npm run web:start, http://localhost:5173) needs an explicit origin here to
# sign in at all — its session cookie only leaves the browser on a credentialed
# request. Name the real origin(s) in production. The mobile app is unaffected
# either way; CORS is a browser rule.
CORS_ORIGINS=http://localhost:5173

# HMAC key for the trip telemetry digest — the signature gate in docs/fraud-detection.md.
# Leave blank in dev: signature verification becomes a no-op and trips are accepted
# unsigned. ENV=production refuses to start without it, min 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TRIP_SIGNING_SECRET=

# How long a driver waits to reissue a voucher for the same reward after one
# expires or is cancelled. Scoped per (driver, reward); redeeming never starts it.
REWARD_REISSUE_COOLDOWN_SECONDS=60
