{
  "expo": {
    "name": "carma-app",
    "slug": "carma-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carmaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carma.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CARMA uses your location to track driving safety and distance.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CARMA tracks your trips in the background to reward safe driving.",
        "NSBluetoothAlwaysUsageDescription": "CARMA connects to your car's Bluetooth to start and end trips automatically.",
        "NSBluetoothPeripheralUsageDescription": "CARMA connects to your car's Bluetooth to start and end trips automatically.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.carma.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBPkf8Oj28BVJtEg204jYidL7xv3m77y4U"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#6366f1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CARMA uses your location to track driving safety and distance.",
          "locationAlwaysAndWhenInUsePermission": "CARMA tracks your trips in the background to reward safe driving.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f45a83b9-40e4-4eb8-a778-a2b468af6547"
      }
    },
    "owner": "mayhajbi"
  }
}