+    /**
+     * PATCHED (CARMA): called on a system-level ACL connection — a device connecting
+     * to the handset, rather than a socket this app opened. Upstream defines
+     * DEVICE_CONNECTED in EventType but never emits it, so onDeviceConnected() on the
+     * JS side can never fire. This emits it, mirroring onACLDisconnected.
+     *
+     * mConnections is deliberately untouched: it tracks RFCOMM sockets this app owns,
+     * and an ACL connection is not one.
+     *
+     * @param device the {@link NativeDevice} which was just connected
+     */
+    @Override
+    public void onACLConnected(NativeDevice device) {
+        Log.d(TAG, "onACLConnected to " + device.getAddress());
+
+        BluetoothDeviceEvent event = new BluetoothDeviceEvent(EventType.DEVICE_CONNECTED, device);
+        sendEvent(EventType.DEVICE_CONNECTED, event.map());
+    }
+
