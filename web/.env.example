# The FastAPI server this app signs in against. The server's CORS_ORIGINS
# must name this app's own origin (http://localhost:5173 in dev) — see
# server/.env.example — or the sign-in request is blocked before it leaves
# the browser.
VITE_API_URL=http://localhost:3000

# CAR-203's address-to-coordinates lookup (lib/api/geocoding.ts). Defaults to
# OpenStreetMap's public Nominatim instance when unset — approved for the
# pilot only, no SLA, and the whole app must stay within its aggregate 1
# request/second policy (see the CAR-203 PR description). Point this at a
# self-hosted or alternative Nominatim-compatible instance to replace it
# without a code change.
# VITE_GEOCODING_URL=https://nominatim.openstreetmap.org
