# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Build outputs ────────────────────────────────────────────────────────────
.next/
dist/
build/
out/
*.egg-info/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# ─── Databases ────────────────────────────────────────────────────────────────
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite3

# ─── Secrets & environment ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example
!server/.env.example

# ─── Expo / React Native ──────────────────────────────────────────────────────
mobile/.expo/
mobile/android/
mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# ─── Debug / scratch screenshots ─────────────────────────────────────────────
screen*.png
demo_shots/

# ─── Local check output ──────────────────────────────────────────────────────
# Redirected output from tsc/eslint/jest/git runs, and scratch PR-body drafts.
# One directory so a new fixed-name file here never needs its own .gitignore line.
mobile/.local/
# Belt-and-suspenders: same files by naming convention, in case one ever lands
# outside mobile/.local/ by mistake.
commit-*.txt
*-out.txt
pr-*.txt

# ─── Scratch PR bodies ────────────────────────────────────────────────────────
# --body-file drafts for gh pr create, never meant to be committed.
*-pr-body.md

# ─── Generated schema intermediate ───────────────────────────────────────────
# The schema-drift recipe renders this on the way to generated.ts, which is the
# artifact we actually commit. openapi-typescript cannot read stdin, so the file
# has to land somewhere; it must not land in a commit.
/openapi.json

# ─── Claude Code ─────────────────────────────────────────────────────────────
.claude/settings.local.json
CLAUDE.local.md
/claude-local/

# Scratch files a session may drop in the repo root by mistake instead of the
# scratchpad — draft PR bodies, saved command output. Belongs local, never committed.
git-diff-*.txt

# scratch files for redirected command output and drafted PR/commit text —
# fixed filenames, always overwritten, never one per PR
.local/
