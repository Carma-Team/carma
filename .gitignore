# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Build outputs ────────────────────────────────────────────────────────────
.next/
dist/
build/
out/
*.egg-info/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# ─── Databases ────────────────────────────────────────────────────────────────
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite3

# ─── Secrets & environment ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example
!server/.env.example

# ─── Expo / React Native ──────────────────────────────────────────────────────
mobile/.expo/
mobile/android/
mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# ─── Debug / scratch screenshots ─────────────────────────────────────────────
screen*.png
demo_shots/

# ─── Local check output ──────────────────────────────────────────────────────
# Standing output file for tsc/eslint/jest runs redirected from the terminal.
# One fixed path on purpose, so the command can be re-run from shell history.
tsc-out.txt

# ─── Scratch PR bodies ────────────────────────────────────────────────────────
# --body-file drafts for gh pr create, never meant to be committed.
*-pr-body.md

# ─── Generated schema intermediate ───────────────────────────────────────────
# The schema-drift recipe renders this on the way to generated.ts, which is the
# artifact we actually commit. openapi-typescript cannot read stdin, so the file
# has to land somewhere; it must not land in a commit.
/openapi.json

# ─── Claude Code ─────────────────────────────────────────────────────────────
.claude/settings.local.json
CLAUDE.local.md
/claude-local/
